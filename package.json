{
  "name": "imagegen-cli",
  "version": "0.2.0",
  "description": "Concurrent image generation and a portable terminal image library",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DovieW/imagegen-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DovieW/imagegen-cli/issues"
  },
  "homepage": "https://github.com/DovieW/imagegen-cli",
  "scripts": {
    "build": "bun run build.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload",
    "format": "prettier --write src tests build.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "pngjs": "^7.0.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pngjs": "^6.0.5",
    "bun": "1.3.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "seroval": "1.7.6",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
